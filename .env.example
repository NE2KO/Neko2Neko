# Send rate limiter for WhatsApp (channel + status). Telegram is instant/unlimited.
# Frekuensi diatur dari UI (Settings Antrian): N kirim/hari = 24/N jam.
# SEND_DAILY_CAP = default perDay saat settings DB belum ada (0 = unlimited).
SEND_DAILY_CAP=

# Telegram bot (send to Telegram group). Secret — do NOT commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# WhatsApp bot
TARGET_CHAT_JID=
ALLOWED_GROUPS=

# Server settings
PORT=3001
MEDIA_ROOT=/home/CATIAA/homelab
# Music library direct (opsi A): vault tetap homelab, Music langsung ke folder ini (tidak via homelab/Music symlink)
MUSIC_ROOT=/home/CATIAA/Music
# Combined scan roots = MEDIA_ROOT + MUSIC_ROOT (engine resolves via both, scanner vault-only for DB compat)

# TLS (optional)
TLS_KEY=
TLS_CERT=

# Monitor settings
MONITOR_DISABLE_GPU=

# Display (for scrcpy)
DISPLAY=:
